# Hex Explorer Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-minimum-256-bits
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hexexplorer
# Alternative for SQLite during development:
# DATABASE_URL=sqlite:///hexexplorer.db

# Redis Configuration (for sessions)
REDIS_URL=redis://localhost:6379/0

# Security Settings
SESSION_LIFETIME_HOURS=24
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Ollama API (for game descriptions)
OLLAMA_API_URL=http://localhost:11434

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=5000
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/hexexplorer.log

# Optional: Email Configuration (for password resets)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret